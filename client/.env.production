# Loaded automatically by `npm run build` (Vite production mode).
# Static deploy: no backend needed — content comes from src/lib/fallback.js.
VITE_STATIC=true

# Used for the live GitHub section (fetched straight from the public GitHub API).
VITE_GITHUB_USERNAME=elmahdi004

# OPTIONAL — makes the contact form actually email you, still with no backend.
# Grab a free access key at https://web3forms.com (just enter your email),
# paste it below, redeploy. If left empty the form falls back to opening the
# visitor's mail app (mailto:) instead.
VITE_WEB3FORMS_KEY=74bbddba-8c15-40d4-97b8-26176a01ff78
